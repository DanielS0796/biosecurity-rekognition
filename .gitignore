# Dependencias — se instalan con npm install, no se versionan.
# El Lambda se empaqueta con source_dir, así que hay que correr
# `npm install` dentro de lambda/ antes de un terraform apply.
node_modules/

# Terraform
.terraform/
# El estado lleva dentro las variables sensibles en claro. El comodín
# cubre también los respaldos con fecha que deja migrar-estado.sh.
terraform.tfstate*
lambda_build/

# Artefactos
*.zip
*.bundle
.next/

# Credenciales locales de Terraform
*.tfvars
!*.tfvars.ejemplo
